# Read by Netlify and Cloudflare Pages.
# Pages, the game and dev notes: always check for a newer version, so players get updates straight away.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/play/
  Cache-Control: no-cache
/devnotes.json
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache

# Art and icons change rarely: cache for a day.
/assets/*
  Cache-Control: public, max-age=86400
/play/title.jpg
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
